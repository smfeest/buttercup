@inject IViewLocalizer Localizer
@inject ITimeFormatter TimeFormatter
@model IList<Recipe>
@{
  ViewData["Title"] = Localizer["Title_Recipes"];

  async Task RenderTime(string icon, string labelResource, int? minutes)
  {
    if (minutes.HasValue)
    {
      var formattedTime = TimeFormatter.AsHoursAndMinutes(minutes.Value);
      <li aria-label="@Localizer[labelResource, formattedTime]"><icon name="@icon" /> @formattedTime</li>
    }
  }
}
<icon-sprite name="recipes" />
<div class="recipes-index__header">
  <h1>@Localizer["Title_Recipes"]</h1>
  <input id="recipe-index__filter" class="input-box" placeholder="@Localizer["Label_FindRecipe"]" aria-label="@Localizer["Label_FindRecipe"]" />
</div>
<ul id="recipes-index__list">
  @foreach (var recipe in Model)
  {
    <li class="recipes-index__item">
      <a asp-action="Show" asp-route-id="@recipe.Id">@recipe.Title</a>
      @if (recipe.PreparationMinutes.HasValue || recipe.CookingMinutes.HasValue)
      {
        <ul class="recipes-index__particulars">
        @{
          await RenderTime("blender", "Label_PreparationTime", recipe.PreparationMinutes);
          await RenderTime("cooking-pot", "Label_CookingTime", recipe.CookingMinutes);
        }
        </ul>
      }
    </li>
  }
</ul>
