@inject IViewLocalizer Localizer
@model Buttercup.Web.Models.Authentication.RequestPasswordResetViewModel
@{
  ViewData["Title"] = Localizer["Title_ResetPassword"];
}
<h1>@Localizer["Heading_CheckYourEmail"]</h1>
<p>@Localizer["Message_PasswordResetLinkSent", @Model!.Email]</p>
<a class="push-button" asp-action="RequestPasswordReset">@Localizer["Label_Back"]</a>
