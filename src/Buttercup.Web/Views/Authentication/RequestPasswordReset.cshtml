@inject IViewLocalizer Localizer
@model Buttercup.Web.Models.Authentication.RequestPasswordResetViewModel
@{
  ViewData["Title"] = Localizer["Title_ResetPassword"];
}
<h1>@Localizer["Heading_ForgotYourPassword"]</h1>
<p>@Localizer["Label_Instructions"]</p>
<form class="form" method="post">
  <div asp-validation-summary="ModelOnly"></div>
  <div class="form-field">
    <label class="form-field__label" asp-for="Email">@Localizer["Label_Email"]</label>
    <input class="input-box" asp-for="Email" required>
    <span asp-validation-for="Email"></span>
  </div>
  <button class="push-button push-button--primary">@Localizer["Label_Continue"]</button>
</form>
